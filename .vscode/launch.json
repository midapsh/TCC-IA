	"version": "0.2.0",
	"configurations": [
		{
			"name": "Python: Unimed (Dev)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/src/main.py",
			"console": "integratedTerminal",
			"justMyCode": false,
			"preLaunchTask": "set-env:dev",
			"args": [
				"event_unimed",
				"{}"
			],
			"envFile": "${workspaceFolder}/.env"
		},
		{
			"name": "Python: Unimed (Prod)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/src/main.py",
			"console": "integratedTerminal",
			"justMyCode": false,
			"preLaunchTask": "set-env:prod",
			"args": [
				"event_unimed",
				"{}"
			],
			"envFile": "${workspaceFolder}/.env"
		}
	]
}
